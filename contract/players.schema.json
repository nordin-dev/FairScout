{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fairscout/players.schema.json",
  "title": "Fair Scout players.json",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "club": {
        "type": "string"
      },
      "league_id": {
        "type": "string"
      },
      "league_name": {
        "type": "string"
      },
      "position_group": {
        "enum": [
          "Attack",
          "Midfield",
          "Defender",
          "Goalkeeper"
        ]
      },
      "position": {
        "type": "string"
      },
      "age": {
        "type": "number",
        "minimum": 0
      },
      "birth_quarter": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4
      },
      "height_cm": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "foot": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "value_eur": {
        "type": "number",
        "minimum": 0
      },
      "value_date": {
        "type": "string",
        "format": "date",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "contract_until": {
        "anyOf": [
          {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "minutes": {
        "type": "integer",
        "minimum": 0
      },
      "matches": {
        "type": "integer",
        "minimum": 0
      },
      "goals": {
        "type": "integer",
        "minimum": 0
      },
      "assists": {
        "type": "integer",
        "minimum": 0
      },
      "ga90": {
        "type": "number",
        "minimum": 0
      },
      "league_factor": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "league_factor_source": {
        "enum": [
          "moves",
          "estimate"
        ]
      },
      "ga90_adj": {
        "type": "number",
        "minimum": 0
      },
      "involvement": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "role": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "pct": {
        "type": "object",
        "properties": {
          "output": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "scoring": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "creating": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "involvement": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "role": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "output",
          "scoring",
          "creating",
          "involvement",
          "role"
        ],
        "additionalProperties": false
      },
      "score": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "score_rank_pct": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          {
            "type": "null"
          }
        ]
      },
      "tier": {
        "enum": [
          "A",
          "B",
          "C",
          null
        ]
      },
      "drivers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sign": {
              "enum": [
                "+",
                "-"
              ]
            },
            "key": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "sign",
            "key",
            "text"
          ],
          "additionalProperties": false
        }
      },
      "flags": {
        "type": "object",
        "properties": {
          "under18": {
            "type": "boolean"
          },
          "low_sample": {
            "type": "boolean"
          },
          "contract_ending": {
            "type": "boolean"
          },
          "born_q4": {
            "type": "boolean"
          },
          "limited_position_data": {
            "type": "boolean"
          }
        },
        "required": [
          "under18",
          "low_sample",
          "contract_ending",
          "born_q4",
          "limited_position_data"
        ],
        "additionalProperties": false
      },
      "similar": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "similarity": {
              "description": "Whole number from 0 to 100, a display scale, not a probability.",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "diff": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "similarity",
            "diff"
          ],
          "additionalProperties": false
        },
        "maxItems": 3
      },
      "note": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "note_source": {
        "enum": [
          "model",
          "template",
          null
        ]
      },
      "citizenship": {
        "type": "string"
      },
      "value_history": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2
        },
        "maxItems": 12
      },
      "in_pool": {
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "name",
      "club",
      "league_id",
      "league_name",
      "position_group",
      "position",
      "age",
      "birth_quarter",
      "height_cm",
      "foot",
      "value_eur",
      "value_date",
      "contract_until",
      "minutes",
      "matches",
      "goals",
      "assists",
      "ga90",
      "league_factor",
      "league_factor_source",
      "ga90_adj",
      "involvement",
      "role",
      "pct",
      "score",
      "score_rank_pct",
      "tier",
      "drivers",
      "flags",
      "similar",
      "note",
      "note_source",
      "citizenship",
      "value_history",
      "in_pool"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "in_pool": {
              "const": true
            }
          },
          "required": [
            "in_pool"
          ]
        },
        "then": {
          "properties": {
            "tier": {
              "enum": [
                "A",
                "B",
                "C"
              ]
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "score_rank_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "drivers": {
              "type": "array",
              "minItems": 1
            },
            "flags": {
              "type": "object",
              "properties": {
                "under18": {
                  "type": "boolean"
                },
                "low_sample": {
                  "type": "boolean"
                },
                "contract_ending": {
                  "type": "boolean"
                },
                "born_q4": {
                  "type": "boolean"
                },
                "limited_position_data": {
                  "type": "boolean"
                }
              },
              "required": [
                "under18",
                "low_sample",
                "contract_ending",
                "born_q4",
                "limited_position_data"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "tier",
            "score",
            "score_rank_pct",
            "drivers",
            "flags"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "note": {
                    "type": "null"
                  }
                },
                "required": [
                  "note"
                ]
              },
              "then": {
                "properties": {
                  "note_source": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "else": {
          "properties": {
            "score": {
              "type": "null"
            },
            "score_rank_pct": {
              "type": "null"
            },
            "tier": {
              "type": "null"
            },
            "note": {
              "type": "null"
            },
            "note_source": {
              "type": "null"
            },
            "drivers": {
              "type": "array",
              "maxItems": 0
            },
            "similar": {
              "type": "array",
              "maxItems": 0
            }
          },
          "required": [
            "score",
            "score_rank_pct",
            "tier",
            "note",
            "note_source",
            "drivers",
            "similar"
          ]
        }
      }
    ]
  }
}
