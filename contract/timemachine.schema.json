        "required": [
          "season",
          "decision_date",
          "outcome_date",
          "trained_on",
          "training_rows",
          "pool",
          "pool_rate",
          "hits",
          "picks"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "as_of",
    "six_seasons",
    "outcome_ranges",
    "seasons"
  ],
  "additionalProperties": false
}
